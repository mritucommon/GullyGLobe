      <path d="M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13" />
    </svg>
  {% when 'map-pin' %}
    <svg class="icon icon-{{ icon_name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">

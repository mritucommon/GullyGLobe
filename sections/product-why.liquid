<section class="product-why">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <div class="product-why__grid">
      {% for block in section.blocks %}
        <article class="product-why__card" {{ block.shopify_attributes }}>
          <span class="product-why__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3>
            <span class="product-why__desktop">{{ block.settings.title }}</span>
            <span class="product-why__mobile">{{ block.settings.mobile_title | default: block.settings.title }}</span>
          </h3>
          <p>
            <span class="product-why__desktop">{{ block.settings.text }}</span>
            <span class="product-why__mobile">{{ block.settings.mobile_text | default: block.settings.text }}</span>
          </p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .product-why {
    padding: 104px 0 110px;
    background: var(--color-background);
  }

  .product-why h2 {
    margin-bottom: 44px;
    color: var(--color-primary-dark);
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    line-height: 1;
  }

  .product-why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  .product-why__card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 26px 24px 30px;
    background: var(--color-surface);
  }

  .product-why__number {
    display: block;
    color: var(--color-secondary);
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
  }

  .product-why h3 {
    margin-top: 14px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.35;
    text-transform: none;
  }

  .product-why p {
    margin-top: 12px;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .product-why__mobile {
    display: none;
  }

  @media (max-width: 849px) {
    .product-why {
      padding: 0 0 28px;
      background: var(--color-surface);
    }

    .product-why .page-width {
      border-top: 1px solid var(--color-divider);
      padding-top: 22px;
    }

    .product-why h2 {
      margin-bottom: 16px;
      font-size: clamp(1.7rem, 7.5vw, 2rem);
    }

    .product-why__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .product-why__card {
      border: 0;
      border-radius: 10px;
      padding: 16px 14px 18px;
      background: var(--color-background);
    }

    .product-why__number {
      color: var(--color-primary-dark);
      font-size: 1.5rem;
    }

    .product-why h3 {
      margin-top: 10px;
      font-size: 0.95rem;
    }

    .product-why p {
      margin-top: 6px;
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .product-why__desktop {
      display: none;
    }

    .product-why__mobile {
      display: inline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_why.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Why this product"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "t:sections.product_why.point",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "title", "label": "t:labels.title", "default": "Reason" },
        { "type": "textarea", "id": "text", "label": "t:labels.text" },
        { "type": "text", "id": "mobile_title", "label": "t:labels.mobile_title" },
        { "type": "text", "id": "mobile_text", "label": "t:labels.mobile_text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_why.name",
      "blocks": [
        { "type": "point", "settings": { "title": "Sun-cured for 21 days", "text": "The way it has always been done, for depth you can’t rush.", "mobile_title": "Sun-cured 21 days", "mobile_text": "Depth you can’t rush." } },
        { "type": "point", "settings": { "title": "Cold-pressed mustard oil", "text": "Kachi ghani oil, pungent and clean.", "mobile_title": "Cold-pressed oil", "mobile_text": "Kachi ghani mustard." } },
        { "type": "point", "settings": { "title": "Hand-cut Rajapuri mango", "text": "Firm, sour, and cut in large pieces.", "mobile_title": "Hand-cut mango", "mobile_text": "Firm Rajapuri pieces." } },
        { "type": "point", "settings": { "title": "No vinegar, no colour", "text": "Preserved with salt, oil and spice only.", "mobile_title": "No vinegar", "mobile_text": "Salt, oil and spice only." } }
      ]
    }
  ]
}
{% endschema %}

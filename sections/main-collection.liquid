{% javascript %}
  (function () {
    function init() {
      var drawer = document.getElementById('CollectionFilterDrawer');
      var backdrop = document.querySelector('.collection-filter-backdrop');
      if (!drawer || !backdrop) return;

      document.body.appendChild(backdrop);
      document.body.appendChild(drawer);

      function isOpen() {
        return drawer.classList.contains('is-open');
      }

      function setOpen(open) {
        drawer.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('filter-open', open);
        drawer.setAttribute('aria-hidden', String(!open));
        document.querySelectorAll('[data-filter-open]').forEach(function (button) {
          button.setAttribute('aria-expanded', String(open));
        });
      }

      document.addEventListener('click', function (event) {
        if (event.target.closest('[data-filter-open]')) {
          setOpen(true);
        } else if (event.target.closest('[data-filter-close]')) {
          setOpen(false);
        } else if (event.target.closest('[data-filter-clear]')) {
          drawer.querySelectorAll('.collection-filter-drawer__group button.is-active').forEach(function (button) {
            button.classList.remove('is-active');
          });
          drawer.querySelectorAll('input[type="checkbox"]').forEach(function (input) {
            input.checked = false;
          });
        } else {
          var option = event.target.closest('.collection-filter-drawer__group button');
          if (option && drawer.contains(option)) option.classList.toggle('is-active');
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && isOpen()) setOpen(false);
      });

      window.addEventListener('pageshow', function () {
        setOpen(false);
      });
    }

    function applySort(value) {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', value);
      url.searchParams.delete('page');
      window.location.href = url.toString();
    }

    function initSort() {
      document.querySelectorAll('[data-sort-select]').forEach(function (select) {
        select.addEventListener('change', function () { applySort(select.value); });
      });

      var sheet = document.getElementById('CollectionSortSheet');
      var backdrop = document.querySelector('.collection-sort-backdrop');
      if (!sheet || !backdrop) return;

      document.body.appendChild(backdrop);
      document.body.appendChild(sheet);

      function setOpen(open) {
        sheet.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        document.documentElement.classList.toggle('sort-open', open);
        sheet.setAttribute('aria-hidden', String(!open));
        document.querySelectorAll('[data-sort-open]').forEach(function (button) {
          button.setAttribute('aria-expanded', String(open));
        });
      }

      document.addEventListener('click', function (event) {
        if (event.target.closest('[data-sort-open]')) {
          setOpen(true);
          return;
        }
        if (event.target.closest('[data-sort-close]')) {
          setOpen(false);
          return;
        }
        var option = event.target.closest('[data-sort-value]');
        if (option && sheet.contains(option)) {
          if (option.classList.contains('is-active')) {
            setOpen(false);
            return;
          }
          sheet.querySelectorAll('[data-sort-value]').forEach(function (button) {
            var active = button === option;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          applySort(option.getAttribute('data-sort-value'));
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && sheet.classList.contains('is-open')) setOpen(false);
      });

      window.addEventListener('pageshow', function () {
        setOpen(false);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { init(); initSort(); });
    } else {
      init();
      initSort();
    }
  })();

  document.querySelectorAll('[data-load-more]').forEach(function (loadMore) {
    var link = loadMore.querySelector('[data-load-more-link]');
    var grid = loadMore.closest('.collection-products').querySelector('.main-collection__grid');

    if (!link || !grid || !('IntersectionObserver' in window)) return;

    function loadNextPage() {
      if (loadMore.classList.contains('is-loading')) return;
      loadMore.classList.add('is-loading');

      fetch(link.href)
        .then(function (response) { return response.text(); })
        .then(function (html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var nextGrid = doc.querySelector('.main-collection__grid');
          var nextLoadMore = doc.querySelector('[data-load-more]');
          var nextLink = doc.querySelector('[data-load-more-link]');

          if (nextGrid) {
            Array.prototype.forEach.call(nextGrid.children, function (item) {
              grid.appendChild(item);
            });
          }

          if (nextLoadMore) {
            loadMore.querySelector('[data-current-count-text]').textContent = nextLoadMore.getAttribute('data-current-count');
            var nextProgress = nextLoadMore.querySelector('.collection-load-more__bar i');
            var progress = loadMore.querySelector('.collection-load-more__bar i');
            if (nextProgress && progress) {
              progress.style.setProperty('--progress', nextProgress.style.getPropertyValue('--progress'));
            }
          }

          if (nextLink) {
            link.href = nextLink.href;
            loadMore.classList.remove('is-loading');
          } else {
            link.remove();
            observer.disconnect();
          }
        })
        .catch(function () {
          loadMore.classList.remove('is-loading');
        });
    }

    var observer = new IntersectionObserver(function (entries) {
      if (entries.some(function (entry) { return entry.isIntersecting; })) {
        loadNextPage();
      }
    }, { rootMargin: '240px 0px' });

    observer.observe(loadMore);
    link.addEventListener('click', function (event) {
      event.preventDefault();
      loadNextPage();
    });
  });
{% endjavascript %}


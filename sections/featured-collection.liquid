<section class="featured-collection">
  <div class="page-width">
    <div class="featured-collection__header">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.collection != blank %}
        <a href="{{ section.settings.collection.url }}">{{ 'sections.featured_collection.button' | t }}</a>
      {% endif %}
    </div>

    <div class="featured-collection__grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% for index in (1..4) %}
          <div class="featured-collection__placeholder">
            {{ 'product-' | append: index | placeholder_svg_tag }}
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .featured-collection {
    padding: 44px 0;
    background: var(--color-surface);
  }

  .featured-collection__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
  }

  .featured-collection h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    letter-spacing: 0;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .featured-collection__placeholder {
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-image-ground);
    aspect-ratio: 1;
  }

  @media (max-width: 989px) {
    .featured-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.featured_collection.heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}

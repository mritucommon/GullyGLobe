<section class="shop-by-need">
  <div class="page-width">
    <div class="shop-by-need__header">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="shop-by-need__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="shop-by-need__grid">
      {% for block in section.blocks %}
        <a class="shop-by-need__item" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="shop-by-need__media">
            {% if block.settings.image %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 850px) 25vw, 50vw', alt: block.settings.image.alt | default: block.settings.title }}
            {% else %}
              {% render 'icon', name: 'camera' %}
              {% if block.settings.placeholder_text != blank %}
                <strong>{{ block.settings.placeholder_text }}</strong>
              {% endif %}
              <span class="shop-by-need__browse">{{ 'sections.explore_india.browse_files' | t }}</span>
            {% endif %}
          </span>
          <span class="shop-by-need__title">
            {{ block.settings.title }}
            {% render 'icon', name: 'chevron-right' %}
          </span>
          {% if block.settings.description != blank %}
            <span class="shop-by-need__description">{{ block.settings.description }}</span>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .shop-by-need {
    padding: 64px 0;
    background: var(--color-surface);
  }

  .shop-by-need__header {
    display: grid;
    justify-items: center;
    gap: 10px;
    margin-bottom: 40px;
    text-align: center;
  }

  .shop-by-need h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.2rem);
    letter-spacing: 0.02em;
  }

  .shop-by-need__subheading {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  .shop-by-need__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .shop-by-need__item {
    display: grid;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
  }

  .shop-by-need__media {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 8px;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px dashed var(--color-primary);
    border-radius: var(--radius-card);
    padding: 24px;
    background: var(--color-image-ground);
    text-align: center;
  }

  .shop-by-need__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-by-need__media .icon {
    width: 26px;
    height: 26px;
    color: color-mix(in srgb, var(--color-primary-dark) 55%, transparent);
  }

  .shop-by-need__media strong {
    max-width: 24ch;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .shop-by-need__browse {
    border-bottom: 1px solid currentColor;
    color: var(--color-primary-dark);
    font-size: 0.82rem;
  }

  .shop-by-need__title {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-primary-dark);
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  .shop-by-need__title .icon {
    width: 16px;
    height: 16px;
    stroke-width: 2.2;
  }

  .shop-by-need__description {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 849px) {
    .shop-by-need {
      padding: 24px 0;
    }

    .shop-by-need__header {
      justify-items: start;
      margin-bottom: 14px;
      text-align: left;
    }

    .shop-by-need h2 {
      font-size: clamp(1.4rem, 6vw, 1.9rem);
    }

    .shop-by-need__subheading {
      display: none;
    }

    .shop-by-need__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 14px;
    }

    .shop-by-need__media {
      padding: 14px;
    }

    .shop-by-need__media strong {
      display: none;
    }

    .shop-by-need__media .icon {
      width: 22px;
      height: 22px;
    }

    .shop-by-need__browse {
      font-size: 0.8rem;
    }

    .shop-by-need__title {
      font-size: 0.95rem;
    }

    .shop-by-need__title .icon {
      display: none;
    }

    .shop-by-need__description {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.shop_by_need.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by need"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "<p>Start from the moment, not the aisle.</p>"
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "t:sections.shop_by_need.need",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "placeholder_text",
          "label": "t:labels.placeholder_text"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Need"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:labels.description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_by_need.name",
      "blocks": [
        {
          "type": "need",

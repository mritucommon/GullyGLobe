<section class="main-page">
  <div class="page-width">
    <h1>{{ page.title }}</h1>
    <div>{{ page.content }}</div>
  </div>
</section>

{% stylesheet %}
  .main-page {
    padding: 46px 0;
    background: var(--color-surface);
  }

  .main-page h1 {
    margin: 0 0 20px;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: 0;
  }

  .main-page .page-width {
    max-width: 820px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page"
}
{% endschema %}

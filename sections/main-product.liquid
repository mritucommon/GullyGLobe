{% javascript %}
  (function () {
    function formatMoney(cents, template) {
      var value = (cents / 100).toFixed(2);
      var parts = value.split('.');
      var withCommas = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + parts[1];
      return template.replace(/\{\{\s*(\w+)\s*\}\}/, function (match, key) {
        if (key === 'amount_no_decimals') return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        if (key === 'amount_with_comma_separator') return parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ',' + parts[1];
        return withCommas;
      });
    }

    function initGallery(gallery) {
      var track = gallery.querySelector('[data-gallery-track]');
      if (!track) return null;
      var slides = gallery.querySelectorAll('[data-gallery-slide]');
      var thumbs = gallery.querySelectorAll('[data-gallery-thumb]');
      var dots = gallery.querySelectorAll('[data-gallery-dot]');
      var current = gallery.querySelector('[data-gallery-current]');
      var prev = gallery.querySelector('[data-gallery-prev]');
      var next = gallery.querySelector('[data-gallery-next]');
      var active = 0;

      function setActive(index) {
        active = index;
        thumbs.forEach(function (thumb, i) { thumb.classList.toggle('is-active', i === index); });
        dots.forEach(function (dot, i) { dot.classList.toggle('is-active', i === index); });
        if (current) current.textContent = index + 1;
        if (prev) prev.disabled = index === 0;
        if (next) next.disabled = index === slides.length - 1;
      }

      function goTo(index) {
        index = Math.max(0, Math.min(slides.length - 1, index));
        track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft - track.clientLeft, behavior: 'smooth' });
        setActive(index);
      }

      var frame;
      track.addEventListener('scroll', function () {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(function () {
          var index = Math.round(track.scrollLeft / track.clientWidth);
          if (index !== active) setActive(index);
        });
      }, { passive: true });

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () { goTo(parseInt(thumb.getAttribute('data-gallery-thumb'), 10)); });
      });
      if (prev) prev.addEventListener('click', function () { goTo(active - 1); });
      if (next) next.addEventListener('click', function () { goTo(active + 1); });
      track.addEventListener('keydown', function (event) {
        if (event.key === 'ArrowRight') { event.preventDefault(); goTo(active + 1); }
        if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(active - 1); }
      });

      setActive(0);

      return {
        showMedia: function (mediaId) {
          if (!mediaId) return;
          for (var i = 0; i < slides.length; i++) {
            if (slides[i].getAttribute('data-media-id') === String(mediaId)) { goTo(i); return; }
          }
        }
      };
    }

    function initProduct(section) {
      var jsonEl = section.querySelector('[data-product-json]');
      var form = section.querySelector('[data-product-form]');
      if (!jsonEl || !form) return;
      var product = JSON.parse(jsonEl.textContent);
      var moneyFormat = section.getAttribute('data-money-format') || '{{amount}}';
      var gallery = initGallery(section.querySelector('[data-gallery]'));
      var idInput = form.querySelector('[data-variant-id]');
      var qtyInput = form.querySelector('[data-qty-input]');
      var addButton = form.querySelector('[data-add-button]');
      var addLabel = form.querySelector('[data-add-label]');
      var buyNow = form.querySelector('[data-buy-now]');
      var priceEl = section.querySelector('[data-price]');
      var compareEl = section.querySelector('[data-compare-price]');
      var saveEl = section.querySelector('[data-save]');
      var breaks = form.querySelector('[data-quantity-breaks]');
      var stockEl = section.querySelector('[data-stock-text]');
      var texts = {
        add: section.getAttribute('data-text-add'),
        soldOut: section.getAttribute('data-text-sold-out'),
        save: section.getAttribute('data-text-save'),
        each: section.getAttribute('data-text-each'),
        stock: section.getAttribute('data-text-stock'),
        arrives: section.getAttribute('data-text-arrives')
      };
      var variant = product.variants.find(function (v) { return String(v.id) === idInput.value; }) || product.variants[0];

      function money(cents) {
        return formatMoney(cents, moneyFormat);
      }

      function quantity() {
        return Math.max(1, parseInt(qtyInput.value, 10) || 1);
      }

      function syncBuyNow() {
        var barQty = document.querySelector('.mobile-buy-bar [data-bar-qty]');
        if (barQty) barQty.value = quantity();
        if (!buyNow) return;
        buyNow.href = '/cart/' + variant.id + ':' + quantity();
        buyNow.classList.toggle('is-disabled', !variant.available);
      }

      function syncBreaks() {
        if (!breaks) return;
        var qty = quantity();
        breaks.querySelectorAll('[data-break-quantity]').forEach(function (option) {
          var tier = parseInt(option.getAttribute('data-break-quantity'), 10);
          var selected = tier === 3 ? qty >= 3 : qty === tier;
          option.classList.toggle('is-selected', selected);
          option.setAttribute('aria-pressed', String(selected));
          var priceTag = option.querySelector('[data-break-price]');
          if (priceTag) {
            var percent = parseInt(priceTag.getAttribute('data-break-price'), 10);
            priceTag.textContent = texts.each.replace('__PRICE__', money(Math.round(variant.price * percent / 100)));
          }
        });
      }

      function renderVariant() {
        idInput.value = variant.id;
        priceEl.textContent = money(variant.price);
        var onSale = variant.compare_at_price && variant.compare_at_price > variant.price;
        compareEl.hidden = !onSale;
        saveEl.hidden = !onSale;
        if (onSale) {
          compareEl.textContent = money(variant.compare_at_price);
          saveEl.textContent = texts.save.replace('__NUMBER__', Math.floor((variant.compare_at_price - variant.price) * 100 / variant.compare_at_price));
        }
        addButton.disabled = !variant.available;
        addLabel.textContent = variant.available ? texts.add + ' · ' + money(variant.price) : texts.soldOut;
        if (stockEl) stockEl.textContent = variant.available ? texts.stock : texts.soldOut;

        section.querySelectorAll('[data-option-index]').forEach(function (fieldset) {
          var optionIndex = parseInt(fieldset.getAttribute('data-option-index'), 10);
          var selectedValue = variant.options[optionIndex];
          var label = fieldset.querySelector('[data-option-selected]');
          if (label) label.textContent = selectedValue;
          fieldset.querySelectorAll('[data-option-value]').forEach(function (button) {
            var isSelected = button.getAttribute('data-option-value') === selectedValue;
            button.classList.toggle('is-selected', isSelected);
            button.setAttribute('aria-pressed', String(isSelected));
          });
        });

        var mobileBar = document.querySelector('.mobile-buy-bar');
        if (mobileBar) {
          var barId = mobileBar.querySelector('input[name="id"]');
          var barPrice = mobileBar.querySelector('strong');
          var barButton = mobileBar.querySelector('button[type="submit"]');
          if (barId) barId.value = variant.id;
          if (barPrice) barPrice.textContent = money(variant.price);
          if (barButton) barButton.disabled = !variant.available;
        }

        syncBreaks();
        syncBuyNow();

        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        window.history.replaceState({}, '', url.toString());

        if (gallery && variant.featured_media) gallery.showMedia(variant.featured_media.id);
      }

      section.querySelectorAll('[data-option-value]').forEach(function (button) {
        button.addEventListener('click', function () {
          var fieldset = button.closest('[data-option-index]');
          var optionIndex = parseInt(fieldset.getAttribute('data-option-index'), 10);
          var wanted = variant.options.slice();
          wanted[optionIndex] = button.getAttribute('data-option-value');
          var match = product.variants.find(function (v) {
            return v.options.every(function (value, i) { return value === wanted[i]; });
          });
          if (!match) {
            match = product.variants.find(function (v) { return v.options[optionIndex] === wanted[optionIndex]; });
          }
          if (match) {
            variant = match;
            renderVariant();
          }
        });
      });

      form.querySelectorAll('[data-qty-step]').forEach(function (button) {
        button.addEventListener('click', function () {
          qtyInput.value = Math.max(1, quantity() + parseInt(button.getAttribute('data-qty-step'), 10));
          syncBreaks();
          syncBuyNow();
        });
      });

      qtyInput.addEventListener('input', function () {
        syncBreaks();
        syncBuyNow();
      });

      if (breaks) {
        breaks.querySelectorAll('[data-break-quantity]').forEach(function (option) {
          option.addEventListener('click', function () {
            qtyInput.value = option.getAttribute('data-break-quantity');
            syncBreaks();
            syncBuyNow();
          });
        });
      }

      var wishlist = section.querySelector('[data-wishlist-toggle]');
      if (wishlist) {
        wishlist.addEventListener('click', function () {
          wishlist.setAttribute('aria-pressed', String(wishlist.getAttribute('aria-pressed') !== 'true'));
        });
      }

      syncBreaks();
      syncBuyNow();
      initDelivery(section, texts);
    }

    function initDelivery(section, texts) {
      var box = section.querySelector('[data-delivery]');
      if (!box) return;

      function addBusinessDays(date, days) {
        var result = new Date(date);
        while (days > 0) {
          result.setDate(result.getDate() + 1);
          var day = result.getDay();
          if (day !== 0 && day !== 6) days--;
        }
        return result;
      }

      var formatter = new Intl.DateTimeFormat(document.documentElement.lang || undefined, { weekday: 'short', month: 'short', day: 'numeric' });
      var today = new Date();
      var start = addBusinessDays(today, parseInt(box.getAttribute('data-min-days'), 10) || 2);
      var end = addBusinessDays(today, parseInt(box.getAttribute('data-max-days'), 10) || 5);
      var datesEl = box.querySelector('[data-delivery-dates]');
      if (datesEl) datesEl.textContent = texts.arrives.replace('__START__', formatter.format(start)).replace('__END__', formatter.format(end));

      var zipWrap = box.querySelector('[data-zip-wrap]');
      var zipValue = box.querySelector('[data-zip-value]');
      var zipForm = box.querySelector('[data-zip-form]');
      var zipInput = zipForm ? zipForm.querySelector('input') : null;

      function readZip() {
        try { return window.localStorage.getItem('gg-zip') || ''; } catch (error) { return ''; }
      }

      function showZip(zip) {
        if (!zipWrap || !zipValue) return;
        zipValue.textContent = zip;
        zipWrap.hidden = !zip;
      }

      showZip(readZip());

      var changeButton = box.querySelector('[data-zip-change]');
      if (changeButton && zipForm) {
        changeButton.addEventListener('click', function () {
          zipForm.hidden = !zipForm.hidden;
          if (!zipForm.hidden && zipInput) {
            zipInput.value = readZip();
            zipInput.focus();
          }
        });
        zipForm.addEventListener('submit', function (event) {
          event.preventDefault();
          var zip = (zipInput.value || '').trim();
          try { window.localStorage.setItem('gg-zip', zip); } catch (error) {}
          showZip(zip);
          zipForm.hidden = true;
        });
      }
    }

    function init() {
      document.querySelectorAll('[data-product-section]').forEach(initProduct);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
{% endjavascript %}


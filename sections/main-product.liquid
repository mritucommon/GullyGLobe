{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign crumb_collection = collection
  if crumb_collection == blank
    assign crumb_collection = product.collections.first
  endif

  assign is_bestseller = false
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'bestseller'
      assign is_bestseller = true
    endif
  endfor

  assign slot_labels = 'Product,Lifestyle,Video,Customer,Detail' | split: ','
  assign slot_captions = section.settings.placeholder_captions | split: '|'
  assign media_count = product.media.size
  assign slot_count = media_count
  if section.settings.show_placeholder_slots and slot_count < 5
    assign slot_count = 5
  endif
  if slot_count == 0
    assign slot_count = 1
  endif

  assign subtitle = product.metafields.custom.subtitle.value
  assign highlights = product.metafields.custom.highlights.value
  assign tagline = product.metafields.custom.tagline.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign single_option = false
  if product.options.size == 1 and product.has_only_default_variant == false
    assign single_option = true
  endif
-%}

<section
  class="main-product"
  data-product-section
  data-money-format="{{ shop.money_format | strip_html | escape }}"
  data-text-add="{{ 'sections.main_product.add_to_cart' | t | escape }}"
  data-text-sold-out="{{ 'general.products.sold_out' | t | escape }}"
  data-text-save="{{ 'sections.main_product.save' | t: number: '__NUMBER__' | escape }}"
  data-text-each="{{ 'sections.main_product.each' | t: price: '__PRICE__' | escape }}"
  data-text-stock="{{ 'sections.main_product.in_stock_ships' | t: days: section.settings.ships_in_days | escape }}"
  data-text-arrives="{{ 'sections.main_product.arrives' | t: start: '__START__', end: '__END__' | escape }}"
>
  <div class="page-width">
    <nav class="product-breadcrumb" aria-label="{{ 'sections.main_product.breadcrumb' | t }}">
      <a href="{{ routes.root_url }}">{{ 'sections.main_product.home' | t }}</a>
      <span aria-hidden="true">/</span>
      {% if crumb_collection %}
        <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
        <span aria-hidden="true">/</span>
      {% endif %}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="main-product__inner">
      <div class="product-gallery" data-gallery>
        {% if is_bestseller %}
          <p class="product-gallery__badge-mobile">{{ 'general.products.bestseller' | t }}</p>
        {% endif %}

        <div class="product-gallery__stage">
          <div class="product-gallery__track" data-gallery-track tabindex="0" aria-label="{{ 'sections.main_product.gallery' | t }}">
            {% for i in (1..slot_count) %}
              {%- liquid
                assign index0 = forloop.index0
                assign media = product.media[index0]
                assign label = slot_labels[index0] | default: slot_labels.last
                if media != blank and index0 > 0
                  assign label = blank
                endif
                if media.media_type == 'video' or media.media_type == 'external_video'
                  assign label = 'Video'
                endif
                assign caption = slot_captions[index0] | strip | default: product.title
              -%}
              <div class="product-gallery__slide" data-gallery-slide data-media-id="{{ media.id }}" aria-label="{{ forloop.index }} / {{ slot_count }}">
                {% if label != blank %}<span class="product-gallery__label">{{ label }}</span>{% endif %}
                {% if media %}
                  {% case media.media_type %}
                    {% when 'video' %}
                      {{ media | video_tag: controls: true, playsinline: true, class: 'product-gallery__video' }}
                    {% when 'external_video' %}
                      {{ media | external_video_tag: class: 'product-gallery__video' }}
                    {% else %}
                      {%- if forloop.first -%}{%- assign slide_loading = 'eager' -%}{%- else -%}{%- assign slide_loading = 'lazy' -%}{%- endif -%}
                      {{ media.preview_image | image_url: width: 1400 | image_tag: loading: slide_loading, widths: '400, 700, 1000, 1400', sizes: '(min-width: 850px) 55vw, 100vw', alt: media.alt | default: product.title }}
                  {% endcase %}
                {% else %}
                  <span class="product-gallery__placeholder">
                    {% render 'icon', name: 'camera' %}
                    <strong>{{ caption }}</strong>
                    <em>{{ 'sections.explore_india.browse_files' | t }}</em>
                  </span>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {% if slot_count > 1 %}
            <div class="product-gallery__counter">
              <button type="button" data-gallery-prev aria-label="{{ 'sections.main_product.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
              <span><b data-gallery-current>1</b> / {{ slot_count }}</span>
              <button type="button" data-gallery-next aria-label="{{ 'sections.main_product.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
            </div>
          {% endif %}
        </div>

        {% if slot_count > 1 %}
          <div class="product-gallery__dots" aria-hidden="true">
            {% for i in (1..slot_count) %}
              <span class="product-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot></span>
            {% endfor %}
          </div>

          <div class="product-gallery__thumbs">
            {% for i in (1..slot_count) %}
              {%- liquid
                assign index0 = forloop.index0
                assign media = product.media[index0]
                assign label = slot_labels[index0] | default: slot_labels.last
                assign is_video = false
                if media != blank
                  assign label = blank
                endif
                if media.media_type == 'video' or media.media_type == 'external_video'
                  assign label = 'Video'
                  assign is_video = true
                endif
                if media == blank and label == 'Video'
                  assign is_video = true
                endif
              -%}
              <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ index0 }}" aria-label="{{ label }} {{ forloop.index }}">
                {% if media %}
                  {{ media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                {% else %}
                  <span class="product-gallery__thumb-placeholder">
                    {% render 'icon', name: 'camera' %}
                    <em>{{ 'sections.explore_india.browse_files' | t }}</em>
                  </span>
                {% endif %}
                {% if is_video %}
                  <span class="product-gallery__play" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" /></svg></span>
                {% endif %}
                {% if label != blank %}<span class="product-gallery__thumb-label">{{ label }}</span>{% endif %}
              </button>
            {% endfor %}
          </div>
        {% endif %}

        {% if crumb_collection %}
          <nav class="product-breadcrumb-mobile" aria-label="{{ 'sections.main_product.breadcrumb' | t }}">
            <a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a>
            {% if product.type != blank %}
              <span aria-hidden="true">/</span>
              <span>{{ product.type }}</span>
            {% endif %}
          </nav>
        {% endif %}
      </div>

      <div class="product-info">
        {% if is_bestseller %}
          <p class="product-info__badge">{{ 'general.products.bestseller' | t }}</p>
        {% endif %}

        <h1>{{ product.title }}</h1>

        {% if subtitle != blank %}
          <p class="product-info__subtitle">{{ subtitle }}</p>
        {% endif %}

        {% if highlights != blank %}
          <ul class="product-info__highlights">
            {% for highlight in highlights %}
              <li>{% render 'icon', name: 'check' %}{{ highlight }}</li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if rating != blank %}
          <div class="product-info__rating">
            <span class="product-info__stars" aria-hidden="true">
              {% for i in (1..5) %}{% render 'icon', name: 'star' %}{% endfor %}
            </span>
            <strong>{{ rating.rating | round: 1 }}</strong>
            {% if rating_count != blank %}
              <a href="#reviews">{{ 'sections.main_product.reviews_count' | t: number: rating_count }}</a>
            {% endif %}
          </div>
        {% endif %}

        <div class="product-info__price" data-price-wrapper>
          <span class="product-info__price-current" data-price>{{ current_variant.price | money }}</span>
          <s class="product-info__price-compare" data-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
          {%- liquid
            assign save_percent = 0
            if current_variant.compare_at_price > current_variant.price
              assign save_amount = current_variant.compare_at_price | minus: current_variant.price
              assign save_percent = save_amount | times: 100 | divided_by: current_variant.compare_at_price
            endif
          -%}
          <span class="product-info__save" data-save{% if save_percent == 0 %} hidden{% endif %}>{{ 'sections.main_product.save' | t: number: save_percent }}</span>
        </div>

        {% if tagline != blank %}
          <p class="product-info__tagline">{{ tagline }}</p>
        {% endif %}

        {% form 'product', product, class: 'product-info__form', data-product-form: '' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          <div class="product-info__terms">{{ form | payment_terms }}</div>

          {% unless product.has_only_default_variant %}
            {% for option in product.options_with_values %}
              {%- assign option_index = forloop.index0 -%}
              <fieldset class="product-options" data-option-index="{{ option_index }}">
                <legend>{{ option.name }}: <span data-option-selected>{{ option.selected_value }}</span></legend>
                <div class="product-options__values">
                  {% for value in option.values %}
                    {%- liquid
                      assign value_variant = blank
                      if single_option
                        for variant in product.variants
                          if variant.option1 == value
                            assign value_variant = variant
                          endif
                        endfor
                      endif
                      assign value_selected = false
                      if option.selected_value == value
                        assign value_selected = true
                      endif
                      assign value_sold_out = false
                      if value_variant != blank and value_variant.available == false
                        assign value_sold_out = true
                      endif
                    -%}
                    <button
                      type="button"
                      class="product-options__value{% if value_selected %} is-selected{% endif %}{% if value_sold_out %} is-sold-out{% endif %}"
                      data-option-value="{{ value | escape }}"
                      aria-pressed="{{ value_selected }}"
                    >
                      <strong>{{ value }}</strong>
                      {% if single_option %}
                        <span>{% if value_sold_out %}{{ 'general.products.sold_out' | t }}{% else %}{{ value_variant.price | money }}{% endif %}</span>
                      {% endif %}
                    </button>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          {% endunless %}

          {% if section.settings.show_quantity_breaks %}
            {%- liquid
              assign tier2 = 100 | minus: section.settings.tier2_percent
              assign tier3 = 100 | minus: section.settings.tier3_percent
            -%}
            <div class="product-breaks" data-quantity-breaks data-tier2="{{ section.settings.tier2_percent }}" data-tier3="{{ section.settings.tier3_percent }}">
              <button type="button" class="product-breaks__option is-selected" data-break-quantity="1" aria-pressed="true">
                <strong>{{ 'sections.main_product.buy_n' | t: number: 1 }}</strong>
                <span>{{ 'sections.main_product.standard_price' | t }}</span>
                {%- assign tier1_money = current_variant.price | money -%}
                <b data-break-price="100">{{ 'sections.main_product.each' | t: price: tier1_money }}</b>
              </button>
              <button type="button" class="product-breaks__option" data-break-quantity="2" aria-pressed="false">
                <strong>{{ 'sections.main_product.buy_n' | t: number: 2 }}</strong>
                <span class="is-saving">{{ 'sections.main_product.save' | t: number: section.settings.tier2_percent }}</span>
                {%- assign tier2_money = current_variant.price | times: tier2 | divided_by: 100 | money -%}
                <b data-break-price="{{ tier2 }}">{{ 'sections.main_product.each' | t: price: tier2_money }}</b>
              </button>
              <button type="button" class="product-breaks__option" data-break-quantity="3" aria-pressed="false">
                <strong>{{ 'sections.main_product.buy_n_plus' | t: number: 3 }}</strong>
                <span class="is-saving">{{ 'sections.main_product.save' | t: number: section.settings.tier3_percent }}</span>
                {%- assign tier3_money = current_variant.price | times: tier3 | divided_by: 100 | money -%}
                <b data-break-price="{{ tier3 }}">{{ 'sections.main_product.each' | t: price: tier3_money }}</b>
              </button>
            </div>
          {% endif %}

          <div class="product-info__actions">
            <div class="product-qty">
              <button type="button" data-qty-step="-1" aria-label="{{ 'sections.cart_drawer.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
              <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'sections.main_product.quantity' | t }}</label>
              <input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1" inputmode="numeric" data-qty-input>
              <button type="button" data-qty-step="1" aria-label="{{ 'sections.cart_drawer.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
            </div>

            <p class="product-info__stock" data-stock-text>
              {%- if current_variant.available -%}
                {{ 'sections.main_product.in_stock_ships' | t: days: section.settings.ships_in_days }}
              {%- else -%}
                {{ 'general.products.sold_out' | t }}
              {%- endif -%}
            </p>

            <button type="submit" class="button product-info__add" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
              <span data-add-label>
                {%- if current_variant.available -%}
                  {{ 'sections.main_product.add_to_cart' | t }} · {{ current_variant.price | money }}
                {%- else -%}
                  {{ 'general.products.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>

            <button type="button" class="product-info__wishlist" aria-pressed="false" aria-label="{{ 'sections.header.wishlist' | t }}" data-wishlist-toggle>
              {% render 'icon', name: 'heart' %}
            </button>
          </div>

          <a class="button button--secondary product-info__buy-now{% unless current_variant.available %} is-disabled{% endunless %}" href="/cart/{{ current_variant.id }}:1" data-buy-now>
            {{ 'sections.main_product.buy_now' | t }}
          </a>
        {% endform %}

        {% if section.settings.show_delivery %}
          <div class="product-delivery" data-delivery data-min-days="{{ section.settings.delivery_min_days }}" data-max-days="{{ section.settings.delivery_max_days }}">
            <div class="product-delivery__row">
              {% render 'icon', name: 'truck' %}
              <div>
                <strong data-delivery-dates>{{ 'sections.main_product.arrives_soon' | t }}</strong>
                <p>
                  <span data-zip-wrap hidden>{{ 'sections.main_product.to' | t }} <span data-zip-value></span> · </span>
                  <button type="button" class="product-delivery__zip" data-zip-change>{{ 'sections.main_product.change_zip' | t }}</button>
                  {% if section.settings.delivery_note != blank %}· {{ section.settings.delivery_note }}{% endif %}
                </p>
                <form class="product-delivery__zip-form" data-zip-form hidden>
                  <label class="visually-hidden" for="Zip-{{ section.id }}">{{ 'sections.main_product.zip' | t }}</label>
                  <input id="Zip-{{ section.id }}" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="{{ 'sections.main_product.zip' | t }}">
                  <button type="submit">{{ 'sections.main_product.save_zip' | t }}</button>
                </form>
              </div>
            </div>
            <div class="product-delivery__row">
              {% render 'icon', name: 'undo' %}
              <div>
                <strong>{{ section.settings.returns_title }}</strong>
                <p>
                  <span class="product-delivery__desktop">{{ section.settings.returns_text }}</span>
                  <span class="product-delivery__mobile">{{ section.settings.returns_text_mobile | default: section.settings.returns_text }}</span>
                </p>
              </div>
            </div>
          </div>
        {% endif %}

        {%- assign accordion_blocks = section.blocks | where: 'type', 'collapsible' -%}
        {% if accordion_blocks.size > 0 %}
          <div class="product-accordion">
            {% for block in accordion_blocks %}
              {%- liquid
                assign body = block.settings.content
                if block.settings.metafield != blank
                  assign mf_parts = block.settings.metafield | split: '.'
                  assign mf = product.metafields[mf_parts[0]][mf_parts[1]]
                  if mf != blank and mf.value != blank
                    assign body = mf | metafield_tag
                  endif
                endif
                if block.settings.use_description and product.description != blank
                  assign body = product.description
                endif
              -%}
              {% if body != blank %}
                <details class="product-accordion__item product-accordion__item--{{ block.settings.show_on }}"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
                  <summary>
                    <span>{{ block.settings.title }}</span>
                    <span class="product-accordion__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="product-accordion__body">{{ body }}</div>
                </details>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{% stylesheet %}
  .main-product {
    padding: 0 0 64px;
    background: var(--color-surface);
  }

  .product-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    border-top: 1px solid var(--color-divider);
    padding: 34px 0 20px;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
  }

  .product-breadcrumb a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .product-breadcrumb a:hover {
    color: var(--color-primary-dark);
  }

  .product-breadcrumb [aria-current] {
    color: var(--color-text);
  }

  .product-breadcrumb-mobile {
    display: none;
  }

  .main-product__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.95fr);
    align-items: start;
    gap: 64px;
  }

  .product-gallery {
    position: sticky;
    top: calc(var(--site-header-height, 0px) + 24px);
    min-width: 0;
  }

  .product-gallery__badge-mobile {
    display: none;
  }

  .product-gallery__stage {
    position: relative;
  }

  .product-gallery__track {
    display: flex;
    overflow-x: auto;
    border: 1px dashed color-mix(in srgb, var(--color-primary-dark) 34%, transparent);
    border-radius: 12px;
    background: var(--color-image-ground);
    outline: none;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .product-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .product-gallery__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .product-gallery__slide::before {
    content: "";
    display: block;
    padding-top: 100%;
  }

  .product-gallery__slide img,
  .product-gallery__slide .product-gallery__video,
  .product-gallery__slide iframe,
  .product-gallery__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .product-gallery__slide img,
  .product-gallery__slide .product-gallery__video {
    object-fit: cover;
    background: var(--color-surface);
  }

  .product-gallery__placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    padding: 32px;
    text-align: center;
  }

  .product-gallery__placeholder .icon {
    width: 30px;
    height: 30px;
    color: color-mix(in srgb, var(--color-primary-dark) 52%, transparent);
    stroke-width: 1.6;
  }

  .product-gallery__placeholder strong {
    max-width: 36ch;
    color: var(--color-text-secondary);
    font-size: 1rem;
    font-weight: 700;
  }

  .product-gallery__placeholder em,
  .product-gallery__thumb-placeholder em {
    border-bottom: 1px solid currentColor;
    color: var(--color-text);
    font-size: 0.82rem;
    font-style: normal;
    line-height: 1.1;
  }

  .product-gallery__label {
    position: absolute;
    left: 18px;
    top: 18px;
    z-index: 2;
    border-radius: 3px;
    padding: 5px 12px;
    color: var(--color-primary-dark);
    background: var(--color-surface);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .product-gallery__counter {
    position: absolute;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    padding: 6px 8px;
    background: var(--color-surface);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-primary-dark) 10%, transparent);
    font-size: 0.92rem;
  }

  .product-gallery__counter button {
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    padding: 0;
    color: var(--color-text);
    background: transparent;
    cursor: pointer;
  }

  .product-gallery__counter button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .product-gallery__counter .icon {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }

  .product-gallery__counter b {
    font-weight: 700;
  }

  .product-gallery__dots {
    display: none;
  }

  .product-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .product-gallery__thumb {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px dashed color-mix(in srgb, var(--color-primary-dark) 34%, transparent);
    border-radius: 6px;
    padding: 0;
    background: var(--color-image-ground);
    cursor: pointer;
  }

  .product-gallery__thumb::before {
    content: "";
    display: block;
    padding-top: 100%;
  }

  .product-gallery__thumb.is-active {
    border: 1px solid var(--color-primary-dark);
  }

  .product-gallery__thumb img,
  .product-gallery__thumb-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .product-gallery__thumb img {
    object-fit: cover;
    background: var(--color-surface);
  }

  .product-gallery__thumb-placeholder {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 8px;
    padding: 8px 8px 22px;
    text-align: center;
  }

  .product-gallery__thumb-placeholder .icon {
    width: 26px;
    height: 26px;
    color: color-mix(in srgb, var(--color-primary-dark) 52%, transparent);
    stroke-width: 1.6;
  }

  .product-gallery__thumb-label {
    position: absolute;
    left: 7px;
    bottom: 5px;
    color: var(--color-text-secondary);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-gallery__play {
    position: absolute;
    right: 7px;
    top: 7px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    color: var(--color-primary-dark);
    background: var(--color-surface);
  }

  .product-gallery__play svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }

  .product-info {
    min-width: 0;
  }

  .product-info__badge {
    width: fit-content;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 4px 9px;
    color: var(--color-primary-dark);
    font-size: 0.74rem;
    font-weight: 700;

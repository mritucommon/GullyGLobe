<section class="pantry-promo{% if section.settings.image_position == 'right' %} pantry-promo--reverse{% endif %}">
  <div class="pantry-promo__media">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1200', sizes: '(min-width: 850px) 50vw, 100vw', alt: section.settings.image.alt }}
    {% else %}
      <div class="pantry-promo__placeholder-wrap">
        {% render 'icon', name: 'camera' %}
        {% if section.settings.placeholder_text != blank %}
          <strong>{{ section.settings.placeholder_text }}</strong>
        {% endif %}
        <span>{{ 'sections.pantry_promo.browse_files' | t }}</span>
      </div>
    {% endif %}
  </div>

  <div class="pantry-promo__content">
    <div class="pantry-promo__inner">
      {% if section.settings.eyebrow != blank %}
        <p class="pantry-promo__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}
        <div class="pantry-promo__text pantry-promo__text-full">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.mobile_text != blank %}
        <div class="pantry-promo__text pantry-promo__text-short">{{ section.settings.mobile_text }}</div>
      {% elsif section.settings.text != blank %}
        <div class="pantry-promo__text pantry-promo__text-short">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button pantry-promo__button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pantry-promo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    background: var(--color-background);
  }

  .pantry-promo--reverse {
    direction: rtl;
  }

  .pantry-promo--reverse > * {
    direction: ltr;
  }

  .pantry-promo__media {
    overflow: hidden;
    border-right: 1px dashed color-mix(in srgb, var(--color-primary) 45%, transparent);
    background: var(--color-image-ground);
  }

  .pantry-promo__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pantry-promo__placeholder-wrap {
    height: 100%;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 10px;
    padding: 40px;
    text-align: center;
  }

  .pantry-promo__placeholder-wrap .icon {
    width: 30px;
    height: 30px;
    color: color-mix(in srgb, var(--color-primary-dark) 55%, transparent);
  }

  .pantry-promo__placeholder-wrap strong {
    max-width: 34ch;
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    font-weight: 700;
  }

  .pantry-promo__placeholder-wrap span {
    border-bottom: 1px solid currentColor;
    color: var(--color-primary-dark);
    font-size: 0.85rem;
  }

  .pantry-promo__content {
    display: flex;
    align-items: center;
    background: var(--color-background);
  }

  .pantry-promo__inner {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding: 60px;
    max-width: 560px;
  }

  .pantry-promo__eyebrow {
    margin: 0;
    color: var(--color-primary);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pantry-promo h2 {
    margin: 0;
    max-width: 14ch;
    color: var(--color-primary-dark);
    font-size: clamp(2rem, 3.4vw, 2.9rem);
    line-height: 1.05;
  }

  .pantry-promo__text {
    margin: 0;
    max-width: 42ch;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .pantry-promo__text p {
    margin: 0;
  }

  .pantry-promo__text-short {
    display: none;
  }

  .pantry-promo__button {
    border-color: var(--color-primary);
    color: var(--color-surface);
    background: var(--color-primary);
  }

  @media (max-width: 849px) {
    .pantry-promo {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .pantry-promo--reverse {
      direction: ltr;
    }

    .pantry-promo__media {
      aspect-ratio: 1;
      border-right: 0;
      border-bottom: 1px dashed color-mix(in srgb, var(--color-primary) 45%, transparent);
    }

    .pantry-promo__placeholder-wrap {
      padding: 24px;
    }

    .pantry-promo__inner {
      gap: 12px;
      padding: 32px 24px;
      max-width: none;
    }

    .pantry-promo__eyebrow {
      font-size: 0.8rem;
      letter-spacing: 0.14em;
    }

    .pantry-promo h2 {
      max-width: 16ch;
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    .pantry-promo__text {
      font-size: 0.94rem;
      line-height: 1.5;
    }

    .pantry-promo__text-full {
      display: none;
    }

    .pantry-promo__text-short {
      display: block;
    }

    .pantry-promo__button {
      width: 100%;
      min-height: 50px;
      border-color: var(--color-surface);
      color: var(--color-primary-dark);
      background: var(--color-surface);
      font-size: 0.82rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.pantry_promo.name",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.layout_direction",
      "options": [
        { "value": "left", "label": "Image left" },
        { "value": "right", "label": "Image right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:labels.placeholder_text",
      "default": "A steel thali at dinner: dal, jeera rice, bhindi, a spoon of achar"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow_text",
      "default": "The Pantry"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Some things simply taste like home."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>The atta your mother kneads by feel. Achar from a family recipe. Tea that's strong enough. The staples that are hard to find here and easy to miss.</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_text",
      "label": "t:labels.subheading",
      "info": "t:labels.secondary_button_mobile_label_info",
      "default": "<p>Atta, achar, chai and the staples that are hard to find here and easy to miss.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop food from India"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.pantry_promo.name"
    }
  ]
}
{% endschema %}
